{
  "format_version": 1,
  "name": "NoPostProcess",
  "description": "A deferred-model pipeline with FXAA and no post-processing stage: it skips tone mapping and the colour chain, which is useful to look at raw scene-linear output. Shows how removing a stage is just deleting its node and wiring its neighbours together.",
  "nodes": [
    {
      "id": "start",
      "kind": "core.on_frame_start",
      "params": {},
      "position": [
        0.0,
        120.0
      ]
    },
    {
      "id": "frame",
      "kind": "helio.frame.setup",
      "params": {
        "model": "deferred",
        "reactive_mask": false
      },
      "position": [
        300.0,
        120.0
      ]
    },
    {
      "id": "background",
      "kind": "helio.pass.background",
      "params": {},
      "position": [
        600.0,
        120.0
      ]
    },
    {
      "id": "hiz",
      "kind": "helio.pass.hiz",
      "params": {},
      "position": [
        900.0,
        120.0
      ]
    },
    {
      "id": "gbuffer_clear",
      "kind": "helio.pass.gbuffer_clear",
      "params": {},
      "position": [
        1200.0,
        120.0
      ]
    },
    {
      "id": "fxaa",
      "kind": "helio.pass.fxaa",
      "params": {},
      "position": [
        1500.0,
        120.0
      ]
    },
    {
      "id": "output",
      "kind": "core.output",
      "params": {},
      "position": [
        1800.0,
        120.0
      ]
    }
  ],
  "connections": [
    {
      "from": {
        "node": "start",
        "pin": "out"
      },
      "to": {
        "node": "frame",
        "pin": "in"
      }
    },
    {
      "from": {
        "node": "frame",
        "pin": "out"
      },
      "to": {
        "node": "background",
        "pin": "in"
      }
    },
    {
      "from": {
        "node": "background",
        "pin": "out"
      },
      "to": {
        "node": "hiz",
        "pin": "in"
      }
    },
    {
      "from": {
        "node": "hiz",
        "pin": "out"
      },
      "to": {
        "node": "gbuffer_clear",
        "pin": "in"
      }
    },
    {
      "from": {
        "node": "gbuffer_clear",
        "pin": "out"
      },
      "to": {
        "node": "fxaa",
        "pin": "in"
      }
    },
    {
      "from": {
        "node": "fxaa",
        "pin": "out"
      },
      "to": {
        "node": "output",
        "pin": "in"
      }
    }
  ],
  "comments": [
    {
      "id": "note1",
      "text": "The model parameter on the frame setup node picks the lighting model. Here deferred: geometry is written to a G-buffer, then lit.",
      "position": [
        280.0,
        -80.0
      ],
      "size": [
        320.0,
        160.0
      ],
      "color": [
        0.2,
        0.4,
        0.7,
        0.25
      ],
      "nodes": [
        "frame"
      ]
    },
    {
      "id": "note2",
      "text": "post_process is simply absent. Its input would come from FXAA; here FXAA flows straight into Output.",
      "position": [
        1180.0,
        -80.0
      ],
      "size": [
        560.0,
        160.0
      ],
      "color": [
        0.2,
        0.4,
        0.7,
        0.25
      ],
      "nodes": [
        "fxaa",
        "output"
      ]
    }
  ],
  "sections": [],
  "space_pins": true
}

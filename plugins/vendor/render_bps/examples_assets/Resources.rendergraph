{
  "format_version": 1,
  "name": "Resources",
  "description": "Resource nodes: a transient colour texture, a depth texture and a persistent texture the graph allocates. A resource node has no flow pins, only a resource output named by its Name parameter, which passes read by name. Here they stand beside the flow chain as a catalogue of the parameters (format, size).",
  "nodes": [
    {
      "id": "start",
      "kind": "core.on_frame_start",
      "params": {},
      "position": [
        0.0,
        120.0
      ]
    },
    {
      "id": "background",
      "kind": "helio.pass.background",
      "params": {},
      "position": [
        300.0,
        120.0
      ]
    },
    {
      "id": "output",
      "kind": "core.output",
      "params": {},
      "position": [
        600.0,
        120.0
      ]
    },
    {
      "id": "scratch",
      "kind": "core.texture",
      "params": {
        "format": "rgba16float",
        "name": "scratch_color",
        "size": "half"
      },
      "position": [
        300.0,
        400.0
      ]
    },
    {
      "id": "scratch_depth",
      "kind": "core.depth",
      "params": {
        "name": "scratch_depth",
        "size": "internal"
      },
      "position": [
        600.0,
        400.0
      ]
    },
    {
      "id": "history",
      "kind": "core.persistent_texture",
      "params": {
        "name": "history_color"
      },
      "position": [
        900.0,
        400.0
      ]
    }
  ],
  "connections": [
    {
      "from": {
        "node": "start",
        "pin": "out"
      },
      "to": {
        "node": "background",
        "pin": "in"
      }
    },
    {
      "from": {
        "node": "background",
        "pin": "out"
      },
      "to": {
        "node": "output",
        "pin": "in"
      }
    }
  ],
  "comments": [
    {
      "id": "note1",
      "text": "Sizes: internal (the render resolution), half, quarter, or output (the display resolution). Formats include rgba16float for HDR colour and r8unorm for masks.",
      "position": [
        280.0,
        300.0
      ],
      "size": [
        560.0,
        120.0
      ],
      "color": [
        0.2,
        0.4,
        0.7,
        0.25
      ],
      "nodes": [
        "scratch"
      ]
    },
    {
      "id": "note2",
      "text": "A persistent texture survives between frames: use it for history such as temporal accumulation. A transient texture is recycled between passes within a frame.",
      "position": [
        880.0,
        300.0
      ],
      "size": [
        560.0,
        120.0
      ],
      "color": [
        0.2,
        0.4,
        0.7,
        0.25
      ],
      "nodes": [
        "history"
      ]
    }
  ],
  "sections": [],
  "space_pins": true
}

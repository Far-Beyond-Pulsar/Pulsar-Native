; FBX 7.4.0 project file
; Example: Pyramid.fbx
; A hand-written ASCII FBX. Lines starting with ; are comments.
; One mesh with five vertices: a square base (one quad) and four triangular sides.
; Open it in the Asset Viewer to inspect it, or import it as a native .mesh.
; Coordinates are Y-up, in metres. A polygon is a run of vertex indices in
; PolygonVertexIndex; the last index of each polygon is stored as ~index
; (-index - 1) to mark where it ends.

FBXHeaderExtension:  {
	FBXHeaderVersion: 1003
	FBXVersion: 7400
	Creator: "Pulsar example"
}

GlobalSettings:  {
	Version: 1000
	Properties70:  {
		P: "UpAxis", "int", "Integer", "",1
		P: "UpAxisSign", "int", "Integer", "",1
		P: "FrontAxis", "int", "Integer", "",2
		P: "FrontAxisSign", "int", "Integer", "",1
		P: "CoordAxis", "int", "Integer", "",0
		P: "CoordAxisSign", "int", "Integer", "",1
		P: "UnitScaleFactor", "double", "Number", "",100
	}
}

Definitions:  {
	Version: 100
	Count: 3
	ObjectType: "Geometry" {
		Count: 1
	}
	ObjectType: "Model" {
		Count: 1
	}
	ObjectType: "Material" {
		Count: 1
	}
}

Objects:  {
	Geometry: 1000, "Geometry::Pyramid", "Mesh" {
		; x, y, z for each of the 5 vertices: four base corners, then the apex
		Vertices: *15 {
			a: -1,0,-1, 1,0,-1, 1,0,1, -1,0,1, 0,1.5,0
		}
		; base quad (0 1 2 3) then the four sides, each ending in ~apex (-5)
		PolygonVertexIndex: *16 {
			a: 0,1,2,-4, 1,0,-5, 2,1,-5, 3,2,-5, 0,3,-5
		}
		GeometryVersion: 124
		; one normal per polygon, pointing away from the surface
		LayerElementNormal: 0 {
			Version: 101
			Name: ""
			MappingInformationType: "ByPolygon"
			ReferenceInformationType: "Direct"
			Normals: *15 {
				a: 0,-1,0, 0,0.5547,-0.8321, 0.8321,0.5547,0, 0,0.5547,0.8321, -0.8321,0.5547,0
			}
		}
		; one UV per polygon corner (16 corners): the base fills the 0..1 square,
		; each side is a triangle with its apex at the top centre
		LayerElementUV: 0 {
			Version: 101
			Name: "UVMap"
			MappingInformationType: "ByPolygonVertex"
			ReferenceInformationType: "Direct"
			UV: *32 {
				a: 0,0, 1,0, 1,1, 0,1, 0,0, 1,0, 0.5,1, 0,0, 1,0, 0.5,1, 0,0, 1,0, 0.5,1, 0,0, 1,0, 0.5,1
			}
		}
		LayerElementMaterial: 0 {
			Version: 101
			Name: ""
			MappingInformationType: "AllSame"
			ReferenceInformationType: "IndexToDirect"
			Materials: *1 {
				a: 0
			}
		}
		Layer: 0 {
			Version: 100
			LayerElement:  {
				Type: "LayerElementNormal"
				TypedIndex: 0
			}
			LayerElement:  {
				Type: "LayerElementUV"
				TypedIndex: 0
			}
			LayerElement:  {
				Type: "LayerElementMaterial"
				TypedIndex: 0
			}
		}
	}
	Model: 2000, "Model::Pyramid", "Mesh" {
		Version: 232
		Properties70:  {
			P: "Lcl Translation", "Lcl Translation", "", "A",0,0,0
			P: "Lcl Rotation", "Lcl Rotation", "", "A",0,0,0
			P: "Lcl Scaling", "Lcl Scaling", "", "A",1,1,1
		}
		Shading: T
		Culling: "CullingOff"
	}
	Material: 3000, "Material::Sandstone", "" {
		Version: 102
		ShadingModel: "phong"
		MultiLayer: 0
		Properties70:  {
			P: "DiffuseColor", "Color", "", "A",0.76,0.66,0.45
			P: "SpecularFactor", "Number", "", "A",0.1
			P: "Shininess", "Number", "", "A",8
		}
	}
}

Connections:  {
	; the model hangs off the scene root (id 0); geometry and material off the model
	C: "OO",2000,0
	C: "OO",1000,2000
	C: "OO",3000,2000
}

          "enabled": true,
          "triggers": [],
          "modifiers": [{ "type": "swizzle", "order": "yxz" }],
          "note": "Forward: the key reports on X, the swizzle moves it to Y."
        },
        {
          "id": 2,
          "key": "Keyboard.KeyS",

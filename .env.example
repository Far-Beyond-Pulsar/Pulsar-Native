# Copy to .env for local development.
# Do not put client secrets in this file.
PULSAR_GITHUB_CLIENT_ID=Ov23liq2pcbz47AZRvI9
# Device Flow does not require this, but keep it env-only if needed by future OAuth flows.
PULSAR_GITHUB_CLIENT_SECRET=

# Note: the tracked `.env` at the repository root is intentional. It holds only
# the public GitHub OAuth *client ID* of the Pulsar app (Device Flow, no
# secret), so a fresh clone can sign in. The engine reads it by that exact name
# (`dotenv` in `engine/src/main.rs`, `dotenvy` in `pulsar_auth`), which is why
# it is not renamed. Never put secrets in it; override locally if needed.
